{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=worklane;Username=worklane;Password=worklane"
  },
  "Jwt": {
    "Secret": "",
    "PreviousSecrets": [],
    "Issuer": "Worklane",
    "Audience": "WorklaneClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "FromName": "Worklane"
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:8080"
    ]
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "FileStorage": {
    "LocalPath": "data/attachments",
    "MaxBytes": 10485760,
    "WorkspaceQuotaBytes": 1073741824,
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/gif",
      "image/webp",
      "application/pdf",
      "text/plain",
      "text/csv",
      "application/zip",
      "application/json",
      "application/msword",
      "application/vnd.ms-excel",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation"
    ]
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Tasks": {
    "MaxChildrenPerParent": 50
  },
  "Imports": {
    "MaxBytes": 5242880,
    "MaxRows": 2000,
    "MaxColumns": 64,
    "MaxUncompressedBytes": 20971520,
    "RetentionHours": 24,
    "MaxOpenBatchesPerProject": 10,
    "CommitCommandTimeoutSeconds": 60,
    "RealtimeFanoutLimit": 50
  },
  "RateLimit": {
    "Attachments": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Comments": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "ImportUpload": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "ImportCommit": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    },
    "ImportPreview": {
      "PermitLimit": 60,
      "WindowSeconds": 3600
    },
    "Export": {
      "PermitLimit": 30,
      "WindowSeconds": 3600
    }
  },
  "WorkspaceCreation": {
    "PermitLimit": 10,
    "WindowSeconds": 3600,
    "MaxOwnedWorkspaces": 20
  },
  "InviteCreation": {
    "PermitLimit": 20,
    "WindowSeconds": 3600,
    "MaxPendingInvites": 50
  }
}
