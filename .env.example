# Copy this file to .env and fill in every secret.
# .env and .env.* are git-ignored. This file has placeholders only.
# ./run-local.sh copies this file to .env and fills JWT_SIGNING_KEY when it is empty.

# API JWT signing key. docker-compose.yml requires it and will not start if it is empty.
# Generate: openssl rand -base64 48
JWT_SIGNING_KEY=

# Host ports for ./run-local.sh. The API talks to Postgres on the compose network,
# so these are only the published host ports.
# 5432 is often a native PostgreSQL. 5433 is the existing worklane-pg container.
# Neither is the default here. Change a value, then ./run-local.sh down && ./run-local.sh
WORKLANE_PG_PORT=5434
WORKLANE_WEB_PORT=4200
WORKLANE_API_PORT=5000
WORKLANE_EDGE_PORT=8080

# Absolute path to the Worklane-Web checkout. When unset, ../Worklane-Web
# (a sibling of this repository). ./run-local.sh exports the path it finds.
# WORKLANE_WEB_DIR=

# Local object storage (RustFS).
# Generate each value yourself, for example: openssl rand -hex 24
# Do not use the built-in RustFS default account. Each password must be at least 16 characters.

# Root account. s3-init uses it to bootstrap the bucket. The API does not.
S3_ROOT_USER=
S3_ROOT_PASSWORD=

# Least-privilege application user, created by s3-init and passed to the api
# service as FileStorage__S3__AccessKey / FileStorage__S3__SecretKey.
WL_S3_ACCESS_KEY=
WL_S3_SECRET_KEY=

# off (default) matches Cloudflare R2, which has no bucket versioning.
# on matches the DigitalOcean Spaces path (versioning and noncurrent expiry).
# Application code must not depend on versioning or bucket policy.
# Turning this off after it was on does not clear an existing versioning
# configuration. Reset the volume first: docker compose down -v
WL_S3_VERSIONING=off
