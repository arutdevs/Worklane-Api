# Local object storage (RustFS). Copy this file to .env and fill in every secret.
# Generate each value yourself, for example: openssl rand -hex 24
# Do not use the built-in RustFS default account. Each password must be at least 16 characters.
# .env and .env.* are git-ignored. This file has placeholders only.

# Root account. s3-init uses it to bootstrap the bucket. The API does not.
S3_ROOT_USER=
S3_ROOT_PASSWORD=

# Least-privilege application user, created by s3-init and passed to the api
# service as FileStorage__S3__AccessKey / FileStorage__S3__SecretKey.
WL_S3_ACCESS_KEY=
WL_S3_SECRET_KEY=

# off (default) matches Cloudflare R2, which has no bucket versioning.
# on matches the DigitalOcean Spaces path (versioning and noncurrent expiry).
# Application code must not depend on versioning or bucket policy.
# Turning this off after it was on does not clear an existing versioning
# configuration. Reset the volume first: docker compose down -v
WL_S3_VERSIONING=off
