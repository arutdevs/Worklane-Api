# Frontend has its own separate git repository (Worklane-Web)
web/

# .NET build artifacts
bin/
obj/
*.user

# IDE
.vs/
.vscode/

# Local attachment storage (see FileStorage:LocalPath)
data/

# Local secrets. Placeholder templates (*.env.example) stay tracked.
# .env.example is the only env file that belongs in git.
.env
.env.*
!.env.example
!**/.env.example
deploy/beta/WL63_DONE
# Generated per-env compose overrides and image locks, if one is copied into the tree.
deploy/beta/*.compose.yml
deploy/beta/*.images.lock

# OS
.DS_Store
Thumbs.db
