# Placeholders only. Copy to /etc/worklane/prod.env (root:root, mode 600).
# Never commit the copy. preflight.sh refuses CHANGE_ME and example.com.
# This file does not prove WL-63 is merged. Do not start the stack until it is.
#
# Generate on the VM:
#   JWT:  openssl rand -base64 48
#   age:  age-keygen -o /etc/worklane/backup-age.key && chmod 600 /etc/worklane/backup-age.key
#         The public recipient (age-keygen -y) goes below. The private key does not.

# Compose project name. One stack per Docker host. Default in the compose file is worklane-prod.
COMPOSE_PROJECT_NAME=worklane-prod

# Postgres role and database created by the image entrypoint on an empty volume.
POSTGRES_DB=worklane
POSTGRES_USER=worklane
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key. Base64, at least 32 bytes after decoding. Not the burned dev key.
# The API rejects a missing, short, or known-leaked key before it migrates or listens.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=Worklane
JWT_AUDIENCE=WorklaneClient

# Public origin of the Angular app. Production rejects a loopback host.
# Invitation links are built from this value. No path, no trailing slash.
PUBLIC_APP_ORIGIN=https://app.example.com

# Host header the API accepts, and the edge server_name for the tunnel path.
API_HOSTNAME=api.example.com

# Attachment cap in bytes. 10485760 matches the API default (10 MiB).
FILE_MAX_BYTES=10485760

# Resend SMTP. From address is Email:SmtpUsername until the API grows a separate From field.
# Free tier stops sending at 100 messages per day. There is no overage.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=Worklane

# Cloudflare Tunnel token. Dashboard credential. Not a digest and not this file.
# Ingress hostnames live in deploy/prod/cloudflared/config.yml (template).
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# R2 S3 API. Production endpoint is https://<account-id>.r2.cloudflarestorage.com
# Region auto is the R2 value. Provider Cloudflare is the rclone provider name.
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_REGION=auto
R2_PROVIDER=Cloudflare

# Backup bucket. Daily token: PutObject only (write-only). No GetObject, no DeleteObject.
# Retention is the bucket lifecycle, not a delete from this token.
R2_BUCKET=worklane-backup
R2_BACKUP_ACCESS_KEY_ID=CHANGE_ME
R2_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME

# Restore token: GetObject and ListBucket on the backup bucket only.
# Must be a different token from the daily write key. Used by restore.sh, not by backup.sh.
R2_RESTORE_ACCESS_KEY_ID=CHANGE_ME
R2_RESTORE_SECRET_ACCESS_KEY=CHANGE_ME

# Files bucket for when the API can write objects. The API does not read these today.
# Separate token from the backup token. Do not point the backup job at this bucket.
R2_FILES_BUCKET=worklane-prod-files
R2_FILES_ACCESS_KEY_ID=CHANGE_ME
R2_FILES_SECRET_ACCESS_KEY=CHANGE_ME

# age public recipient (age1...). The private key path is on the VM, not in this file.
# Leave the recipient empty only when you set BACKUP_GPG_RECIPIENT or, for a drill, BACKUP_ALLOW_UNENCRYPTED=1.
BACKUP_AGE_RECIPIENT=CHANGE_ME
BACKUP_AGE_IDENTITY_FILE=/etc/worklane/backup-age.key

# Optional OpenPGP recipient. Used only when BACKUP_AGE_RECIPIENT is empty.
BACKUP_GPG_RECIPIENT=

# Drill escape hatch. Leave empty in production. 1 stores a compressed dump with no age/gpg layer.
BACKUP_ALLOW_UNENCRYPTED=

# Beta cap (WL-67). backup.sh refuses a number above 30. The lifecycle file matches this.
BACKUP_RETENTION_DAYS=30

# Object-key prefix recorded in the dump path. Keep it a short token: letters, digits, hyphens.
BACKUP_PROJECT=worklane-prod

# Set only for a local drill that dumps via `docker exec`. Empty on the VM.
# The VM job sets WORKLANE_COMPOSE_FILE instead and runs pg_dump inside the compose postgres service.
BACKUP_DOCKER_CONTAINER=

# Set by the systemd unit. Empty when the backup container runs the script itself (PGHOST=postgres).
WORKLANE_COMPOSE_FILE=
WORKLANE_COMPOSE_ENV=/etc/worklane/prod.env

# Drill only: rclone talks to S3 from this Docker network, using this image. Empty on the VM.
BACKUP_UPLOAD_NETWORK=
BACKUP_UPLOAD_IMAGE=

# 1 disables multipart uploads. Required for the local rclone S3 server. Empty for R2.
R2_DISABLE_MULTIPART=

# 1 lets a local drill use the same key for write and restore. Do not set this on the VM.
BACKUP_DRILL=

# Better Stack heartbeat URL. A secret. Empty until the monitor exists.
# The script pings it after a successful upload and pings <url>/fail on failure. It does not log the URL.
BETTERSTACK_HEARTBEAT_URL=

# Same idea, for the dump taken before a migration. Empty until that heartbeat exists.
BETTERSTACK_HEARTBEAT_URL_PRE_MIGRATION=

# Not read by the API today. Reserved so the names are not invented later under different spellings.
# Sentry region is undecided (D-74). Do not create the project until อรุษ picks the region.
SENTRY_DSN=
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=
