# Draft image for the compose "backup" service. Compose does not build this.
# CI does not build this. There is no workflow for it (D-33).
# Build on the ARM VM only after WL-63 is merged, then replace the
# placeholder digest on the backup service:
#   docker build --platform linux/arm64 \
#     -f deploy/prod/backup/Dockerfile.draft \
#     -t worklane-backup:local \
#     deploy/prod/backup
# The systemd unit does not need this image. It runs backup.sh on the host.

FROM postgres:16-alpine

RUN apk add --no-cache rclone age ca-certificates \
    && adduser -D -u 1654 -H worklane

COPY backup.sh lib.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/backup.sh /usr/local/bin/lib.sh

USER 1654:1654
ENTRYPOINT ["/usr/local/bin/backup.sh"]
