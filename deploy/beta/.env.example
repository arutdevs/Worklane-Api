# Copy to .env.prod and .env.staging (both git-ignored). Replace every replace-me.
# Generate secrets with: openssl rand -base64 48 | tr -d '\n'
# Do not reuse a secret across prod and staging, or across the keys below.
# Do not put the dev JWT from docker-compose.yml here. WL-63 burned it.
#
# Prod uses the values below. For the staging copy, switch the block marked STAGING.

COMPOSE_PROJECT_NAME=worklane-prod
DOCKER_PLATFORM=linux/arm64
ASPNETCORE_ENVIRONMENT=Production

# Public site. Same origin for the SPA, /api, and /hubs. No trailing slash.
PUBLIC_ORIGIN=https://app.example.com
ALLOWED_HOSTS=app.example.com

POSTGRES_DB=worklane
POSTGRES_USER=worklane_admin
POSTGRES_PASSWORD=replace-me
POSTGRES_APP_USER=worklane_app
POSTGRES_APP_PASSWORD=replace-me
POSTGRES_MIGRATOR_USER=worklane_migrator
POSTGRES_MIGRATOR_PASSWORD=replace-me
POSTGRES_READONLY_USER=worklane_readonly
POSTGRES_READONLY_PASSWORD=replace-me
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=0.60

API_IMAGE=worklane-api:beta
API_PULL_POLICY=never
API_MEM_LIMIT=1536m
API_CPUS=0.70
JWT_SECRET=replace-me
JWT_ISSUER=Worklane
JWT_AUDIENCE=WorklaneClient
FILE_MAX_BYTES=10485760

# Image built from the Worklane-Web repo. This repo does not build it.
WEB_IMAGE=worklane-web:beta
WEB_PULL_POLICY=never
WEB_MEM_LIMIT=128m
WEB_CPUS=0.10

CLOUDFLARED_VERSION=2026.10.1
CLOUDFLARE_TUNNEL_TOKEN=replace-me
CLOUDFLARED_MEM_LIMIT=128m
CLOUDFLARED_CPUS=0.10

# Resend SMTP. Username stays "resend". From-address is a follow-up: the API
# currently uses SmtpUsername as the From address, so mail will not send until
# that is split. See the README.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-me
SMTP_FROM_NAME=Worklane

MIGRATOR_MEM_LIMIT=2g
MIGRATOR_CPUS=1.0

# Backup bucket (dumps only). Separate key from attachments.
R2_ACCOUNT_ID=replace-me
R2_BACKUP_BUCKET=worklane-backup
R2_BACKUP_ACCESS_KEY_ID=replace-me
R2_BACKUP_SECRET_ACCESS_KEY=replace-me
AWS_CLI_IMAGE=amazon/aws-cli:2.38.1
# age public recipient (age1...). Private key stays in a password manager, not here.
BACKUP_AGE_RECIPIENT=replace-me
# Set to 1 only to allow a plaintext dump. Leave unset otherwise.
# BACKUP_ALLOW_UNENCRYPTED=
# Path to the age private key. Used only while restoring. chmod 600. Not committed.
BACKUP_AGE_IDENTITY_FILE=/root/worklane-backup-age.txt
BETTERSTACK_HEARTBEAT_URL_BACKUP=https://uptime.betterstack.com/api/v1/heartbeat/replace-me
BETTERSTACK_HEARTBEAT_URL_PRE_MIGRATION=https://uptime.betterstack.com/api/v1/heartbeat/replace-me

# Attachment mirror until B-18. The API does not read this bucket.
R2_ATTACHMENTS_BUCKET=worklane-attachments
R2_ATTACHMENTS_ACCESS_KEY_ID=replace-me
R2_ATTACHMENTS_SECRET_ACCESS_KEY=replace-me
BETTERSTACK_HEARTBEAT_URL_ATTACHMENTS=https://uptime.betterstack.com/api/v1/heartbeat/replace-me

# Not read by the current API. Wiring them is a follow-up (no OTLP exporter, no Sentry SDK).
# GRAFANA_OTLP_ENDPOINT=
# GRAFANA_OTLP_TOKEN=
# SENTRY_DSN=

# --- STAGING copy: change these lines, and lower the memory limits ---
# COMPOSE_PROJECT_NAME=worklane-staging
# ASPNETCORE_ENVIRONMENT=Staging
# PUBLIC_ORIGIN=https://staging.example.com
# ALLOWED_HOSTS=staging.example.com
# POSTGRES_MEM_LIMIT=1g
# POSTGRES_CPUS=0.30
# POSTGRES_SHARED_BUFFERS=256MB
# API_MEM_LIMIT=768m
# API_CPUS=0.35
# WEB_MEM_LIMIT=96m
# WEB_CPUS=0.05
# CLOUDFLARED_MEM_LIMIT=96m
# CLOUDFLARED_CPUS=0.05
# Use a different JWT, tunnel token, SMTP key, R2 keys, and every database password.
